POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_PORT=5432

REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

FRONTEND_PORT=5173
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
TENANT_SERVICE_PORT=8082
ASSISTANT_SERVICE_PORT=8083
ASSISTANT_EMBEDDING_TEI_PORT=8091
ASSISTANT_RERANKER_TEI_PORT=8092
TICKET_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
ANALYTICS_SERVICE_PORT=8087
WEBHOOK_RECEIVER_PORT=8090

JWT_SECRET=change-me-to-a-long-secret-for-local-dev-only
INTERNAL_SERVICE_TOKEN=opspilot-internal-dev-token
AUTH_SERVICE_BASE_URL=http://localhost:8081
TENANT_SERVICE_BASE_URL=http://localhost:8082
ASSISTANT_SERVICE_URL=http://localhost:8083
TICKET_SERVICE_BASE_URL=http://localhost:8085
VITE_API_BASE_URL=http://localhost:8080

ASSISTANT_EMBEDDING_PROVIDER=tei
ASSISTANT_EMBEDDING_REQUEST_TIMEOUT_MS=10000
ASSISTANT_EMBEDDING_VALIDATE_ON_STARTUP=true
ASSISTANT_EMBEDDING_STUB_DIMENSIONS=1536
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_URL=https://api.openai.com/v1/embeddings
OPENAI_EMBEDDING_DIMENSIONS=1536
ASSISTANT_EMBEDDING_TEI_MODEL=BAAI/bge-small-en-v1.5
ASSISTANT_EMBEDDING_TEI_URL=http://localhost:8091/v1/embeddings
ASSISTANT_EMBEDDING_TEI_DIMENSIONS=384
ASSISTANT_EMBEDDING_OLLAMA_MODEL=nomic-embed-text
ASSISTANT_EMBEDDING_OLLAMA_URL=http://localhost:11434/api/embed
ASSISTANT_EMBEDDING_OLLAMA_DIMENSIONS=768
ASSISTANT_RERANKER_ENABLED=true
ASSISTANT_RERANKER_PROVIDER=tei
ASSISTANT_RERANKER_REQUEST_TIMEOUT_MS=10000
ASSISTANT_RERANKER_VALIDATE_ON_STARTUP=true
ASSISTANT_RERANKER_CANDIDATE_LIMIT=12
ASSISTANT_RERANKER_MAX_PASSAGE_CHARACTERS=1200
ASSISTANT_RERANKER_TEI_MODEL=BAAI/bge-reranker-base
ASSISTANT_RERANKER_TEI_URL=http://localhost:8092/rerank
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_URL=https://api.openai.com/v1/chat/completions
AI_ANSWER_PROVIDER=ollama
AI_ANSWER_REQUEST_TIMEOUT_MS=20000
AI_ANSWER_OLLAMA_MODEL=qwen2.5:7b-instruct
AI_ANSWER_OLLAMA_URL=http://localhost:11434/api/generate
AI_CHAT_DEFAULT_TOP_K=4
AI_CHAT_LOW_CONFIDENCE_THRESHOLD=0.55

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=knowledge-documents
S3_AUTO_CREATE_BUCKET=true

RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
ASSISTANT_MESSAGING_ENABLED=true
TICKET_MESSAGING_ENABLED=true
TICKET_CREATED_EXCHANGE=opspilot.events
TICKET_CREATED_ROUTING_KEY=ticket.created
NOTIFICATION_EXCHANGE=opspilot.events
NOTIFICATION_MESSAGING_ENABLED=true
NOTIFICATION_TICKET_CREATED_QUEUE=notification.ticket.created
NOTIFICATION_DOCUMENT_PROCESSED_QUEUE=notification.document.processed
NOTIFICATION_WEBHOOK_ENABLED=true
NOTIFICATION_WEBHOOK_URL=http://localhost:8090/events
NOTIFICATION_WEBHOOK_AUTH_HEADER_NAME=
NOTIFICATION_WEBHOOK_AUTH_HEADER_VALUE=
